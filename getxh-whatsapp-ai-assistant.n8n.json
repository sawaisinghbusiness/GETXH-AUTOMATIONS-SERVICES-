{
  "name": "GetXH — WhatsApp AI Assistant (Real Estate)",
  "nodes": [
    {
      "parameters": {
        "updates": ["messages"],
        "options": {}
      },
      "id": "a1b2c3d4-0001-4a01-9001-000000000001",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [-1120, 320],
      "webhookId": "getxh-wa-incoming",
      "credentials": {
        "whatsAppTriggerApi": {
          "id": "WA_TRIGGER_CRED",
          "name": "GetXH WhatsApp Trigger"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1-0001",
              "name": "waId",
              "value": "={{ $json.messages?.[0]?.from || $json.contacts?.[0]?.wa_id }}",
              "type": "string"
            },
            {
              "id": "f1-0002",
              "name": "contactName",
              "value": "={{ $json.contacts?.[0]?.profile?.name || 'there' }}",
              "type": "string"
            },
            {
              "id": "f1-0003",
              "name": "messageType",
              "value": "={{ $json.messages?.[0]?.type }}",
              "type": "string"
            },
            {
              "id": "f1-0004",
              "name": "messageText",
              "value": "={{ $json.messages?.[0]?.text?.body || '' }}",
              "type": "string"
            },
            {
              "id": "f1-0005",
              "name": "messageId",
              "value": "={{ $json.messages?.[0]?.id }}",
              "type": "string"
            },
            {
              "id": "f1-0006",
              "name": "receivedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4a01-9001-000000000002",
      "name": "Extract Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-900, 320]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.messageType }}",
                    "rightValue": "text",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Text"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "c2",
                    "leftValue": "={{ $json.messageType }}",
                    "rightValue": "audio",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Audio / Media"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "a1b2c3d4-0003-4a01-9001-000000000003",
      "name": "Route by Message Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [-680, 320]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer name: {{ $('Extract Message').item.json.contactName }}\nCustomer WhatsApp ID: {{ $('Extract Message').item.json.waId }}\nIncoming message: {{ $('Extract Message').item.json.messageText }}",
        "options": {
          "systemMessage": "You are Maya, the friendly AI assistant for GetXH Realty, a real estate agency.\n\nYour goals, in order:\n1. Reply naturally and warmly in the customer's language (English/Hindi/Hinglish).\n2. Answer questions about property availability, price, location and timings.\n3. Qualify the lead by gently collecting: BUY or RENT, budget range, preferred location, and move-in timeline.\n4. When the lead is qualified and interested, propose a site visit and confirm a day/time.\n\nRules:\n- Keep replies short (1-3 sentences), human and on-brand. Use the customer's name when you know it.\n- Never invent exact listings; speak in ranges and offer to share matching options.\n- Always end serious conversations by trying to book a site visit.\n\nAfter your reply, also output a JSON block named lead with fields: intent (buy/rent/unknown), budget, location, timeline, qualified (true/false), bookVisit (true/false), visitDateTime."
        }
      },
      "id": "a1b2c3d4-0004-4a01-9001-000000000004",
      "name": "AI Sales Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [-380, 240]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-6",
        "options": {
          "temperature": 0.6,
          "maxTokensToSample": 1024
        }
      },
      "id": "a1b2c3d4-0005-4a01-9001-000000000005",
      "name": "Anthropic Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.5,
      "position": [-460, 460],
      "credentials": {
        "anthropicApi": {
          "id": "ANTHROPIC_CRED",
          "name": "GetXH Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Extract Message').item.json.waId }}",
        "contextWindowLength": 12
      },
      "id": "a1b2c3d4-0006-4a01-9001-000000000006",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [-300, 460]
    },
    {
      "parameters": {
        "name": "knowledge_base",
        "description": "Look up GetXH property listings, prices, locations and availability to answer customer questions accurately.",
        "operation": "getAllRows"
      },
      "id": "a1b2c3d4-0007-4a01-9001-000000000007",
      "name": "Listings Knowledge Base",
      "type": "n8n-nodes-base.googleSheetsTool",
      "typeVersion": 4.7,
      "position": [-140, 460],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GSHEET_CRED",
          "name": "GetXH Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f2-0001",
              "name": "reply",
              "value": "={{ $json.output }}",
              "type": "string"
            },
            {
              "id": "f2-0002",
              "name": "qualified",
              "value": "={{ $json.output.toLowerCase().includes('site visit') || $json.output.toLowerCase().includes('budget') }}",
              "type": "boolean"
            },
            {
              "id": "f2-0003",
              "name": "bookVisit",
              "value": "={{ $json.output.toLowerCase().includes('site visit') }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0008-4a01-9001-000000000008",
      "name": "Prepare Reply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-40, 240]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "if-1",
              "leftValue": "={{ $json.qualified }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0009-4a01-9001-000000000009",
      "name": "Hot Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [220, 240]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "GETXH_LEADS_SHEET",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "WhatsApp ID": "={{ $('Extract Message').item.json.waId }}",
            "Name": "={{ $('Extract Message').item.json.contactName }}",
            "Last Message": "={{ $('Extract Message').item.json.messageText }}",
            "Status": "Qualified",
            "Updated At": "={{ $now.toISO() }}"
          },
          "matchingColumns": ["WhatsApp ID"]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0010-4a01-9001-000000000010",
      "name": "Save Lead to CRM",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [460, 120],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GSHEET_CRED",
          "name": "GetXH Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "OWNER_NOTIFY_NUMBER_ID",
        "recipientPhoneNumber": "OWNER_WHATSAPP_NUMBER",
        "textBody": "=🔥 New qualified lead!\n\nName: {{ $('Extract Message').item.json.contactName }}\nWhatsApp: {{ $('Extract Message').item.json.waId }}\nLast message: {{ $('Extract Message').item.json.messageText }}\n\nThe AI has it covered — jump in if you want.",
        "additionalFields": {}
      },
      "id": "a1b2c3d4-0011-4a01-9001-000000000011",
      "name": "Alert Owner",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [700, 120],
      "credentials": {
        "whatsAppApi": {
          "id": "WA_SEND_CRED",
          "name": "GetXH WhatsApp Cloud"
        }
      }
    },
    {
      "parameters": {
        "mode": "chooseBranch",
        "numberInputs": 2,
        "options": {}
      },
      "id": "a1b2c3d4-0012-4a01-9001-000000000012",
      "name": "Merge Paths",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [700, 320]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "GETXH_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $('Extract Message').item.json.waId }}",
        "textBody": "={{ $('Prepare Reply').item.json.reply }}",
        "additionalFields": {}
      },
      "id": "a1b2c3d4-0013-4a01-9001-000000000013",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [940, 320],
      "credentials": {
        "whatsAppApi": {
          "id": "WA_SEND_CRED",
          "name": "GetXH WhatsApp Cloud"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f3-0001",
              "name": "reply",
              "value": "Hi {{ $('Extract Message').item.json.contactName }}! 👋 I can help over text — could you please type your question? You can ask about price, location or availability.",
              "type": "string"
            },
            {
              "id": "f3-0002",
              "name": "qualified",
              "value": "false",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0014-4a01-9001-000000000014",
      "name": "Fallback (Non-text)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-40, 460]
    },
    {
      "parameters": {
        "content": "## 📥 Capture\nIncoming WhatsApp messages arrive here and get parsed into clean fields.",
        "height": 260,
        "width": 420,
        "color": 4
      },
      "id": "note-1",
      "name": "Note — Capture",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1160, 180]
    },
    {
      "parameters": {
        "content": "## 🤖 Understand & Respond\nClaude-powered AI Agent with conversation memory + a listings knowledge base. Qualifies the lead and drafts a natural reply.",
        "height": 420,
        "width": 520,
        "color": 5
      },
      "id": "note-2",
      "name": "Note — AI Brain",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-500, 160]
    },
    {
      "parameters": {
        "content": "## 🔥 Qualify, Save & Notify\nHot leads are saved to the CRM and the owner is alerted instantly.",
        "height": 300,
        "width": 480,
        "color": 3
      },
      "id": "note-3",
      "name": "Note — Convert",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [420, 40]
    },
    {
      "parameters": {
        "content": "## 📤 Reply\nThe final answer goes straight back to the customer on WhatsApp.",
        "height": 240,
        "width": 320,
        "color": 6
      },
      "id": "note-4",
      "name": "Note — Send",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [920, 220]
    }
  ],
